<Project Sdk="Microsoft.NET.Sdk">
	
  <PropertyGroup>
    <!-- Select the framework(s) you wish to target.
        Rhino 6: net45
        Rhino 7: net48
        Rhino 8 Windows: net48, net7.0, net7.0-windows, net7.0-windows10.0.22000.0, etc
        Rhino 8 Mac: net7.0, net7.0-macos, net7.0-macos12.0, etc
    -->
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.gha</TargetExt>
    <NoWarn>NU1701;NETSDK1086</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  
  <PropertyGroup>
    <!-- Specifies information for Assembly and Yak -->
    <Version>1.0</Version>
    <Title>Rhino2Fem.Grasshopper.Midas</Title>
    <Company>$(Authors)</Company>
    <Description>Description of Rhino2Fem.Grasshopper.Midas</Description>
	<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	<EnableNETAnalyzers>False</EnableNETAnalyzers>
  </PropertyGroup>
  
  <ItemGroup>
    <Compile Remove="Resources\**" />
    <EmbeddedResource Remove="Resources\**" />
    <None Remove="Resources\**" />
    <Page Remove="Resources\**" />
  </ItemGroup>
  
  <ItemGroup>
	<PackageReference Include="Grasshopper" Version="8.27.26019.16021" />
	<PackageReference Include="RhinoCommon" Version="8.27.26019.16021" />
  </ItemGroup>
  
  <!-- For Windows only builds -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4'))">
    <UseWindowsForms>true</UseWindowsForms>
    <UseWpf>true</UseWpf>
  </PropertyGroup>

  <!-- Reference WinForms for .NET 7.0 on macOS -->
  <ItemGroup Condition="!($(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4')))">
    <!-- Rhino 8.11 and later you can use this -->
    <!-- <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" /> -->
    
    <!-- Rhino 8.10 and earlier -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" ExcludeAssets="all" GeneratePathProperty="true" />
    <Reference Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)\build\.NETFramework\v4.8\System.Windows.Forms.dll" Private="False" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GrasshopperHelper\GrasshopperHelper.csproj" />
    <ProjectReference Include="..\ProxyHelper\ProxyHelper.csproj" />
    <ProjectReference Include="..\Rhino2Fem.Straus.Grasshopper\Rhino2Fem.Grasshopper.csproj" />
    <ProjectReference Include="..\Rhino2Midas.Core\Rhino2Fem.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Components\Preview\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Rhino2Midas.Grasshopper.Properties.Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Rhino2Midas.Grasshopper.Properties.Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Rhino2Midas.Grasshopper.Properties.Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Rhino2Midas.Grasshopper.Properties.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CopyPdbForMonoDebugging" AfterTargets="AfterBuild">
    <!-- Enable debugging in Rhino 6/7 on Mac -->
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFiles="$(TargetDir)$(TargetName).gha.pdb" Condition="$([MSBuild]::IsOSPlatform(OSX)) and $(TargetFramework.StartsWith('net4')) and Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="robocopy $(ProjectDir)bin\$(PlatformName)\$(ConfigurationName)\$(TargetFramework) $(SolutionDir)bin\$(TargetFramework) /E /NFL /NDL /NJH /NJS /NC /NS&#xD;&#xA;del /f /q $(ProjectDir)bin\$(PlatformName)\$(ConfigurationName)\$(TargetFramework)&#xA;exit 0" />
  </Target>

</Project>